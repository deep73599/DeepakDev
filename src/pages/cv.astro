---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    Android Application Engineer with a focus on Kotlin and Firebase. Junior developer experienced in corporate environments and professional documentation. RYA-certified Coastal Skipper with years of leadership experience and a long-term goal of global circumnavigation.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Junior Android Developer"
      subtitle="From Nov 8, 2025 to Jan 7, 2026 at Burger King, Surat, India"
    >
      Working at Valentina Business Hub under the mentorship of Mahendra Singh Solanki. Specialized in developing mobile features for corporate applications within the Burger King ecosystem.
    </TimeLineElement>
    <TimeLineElement
      title="Private Tutor & Mentor"
      subtitle="Academic Mentorship"
    >
      Mentored 15 students in academic logic and technical foundations. Focused on tracking results and preparing students for rigorous examinations.
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="AEC Exam Project"
      subtitle="Topic: Best Practices for Microsoft PowerPoint in Technical Presentations"
    >
      Developed comprehensive documentation and presentation strategies for technical audiences.
    </TimeLineElement>
    <TimeLineElement
      title="RYA Coastal Skipper Certification"
      subtitle="Certified in 2025"
    >
      Advanced certification for offshore navigation and vessel management.
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>Kotlin</li>
    <li>Android Studio</li>
    <li>Firebase</li>
    <li>Firestore</li>
    <li>Jetpack Compose</li>
    <li>Technical Documentation</li>
    <li>Team Leadership</li>
    <li>Navigation</li>
  </ul>
</BaseLayout>
