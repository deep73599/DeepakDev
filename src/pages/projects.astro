---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Professional Projects</div>
  </div>

  <HorizontalCard
    title="StudySyncAI"
    img="/studysync_preview.png" 
    desc="A productivity-focused Android application designed for students. It features specialized TimerActivity logic and background processing to help users manage study sessions effectively."
    url="https://github.com/your-username/studysync-ai"
    badge="KOTLIN"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Studentcorner"
    img="/studentcorner_preview.png"
    desc="A robust application developed to manage and track student exam records. It utilizes Firebase and Firestore for secure data persistence and real-time updates."
    url="https://github.com/your-username/studentcorner"
    badge="FIREBASE"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Academic & Technical Works</div>
  </div>

  <HorizontalCard
    title="Technical Presentation Best Practices"
    img="/presentation_preview.png"
    desc="An AEC exam project documenting best practices for using Microsoft PowerPoint in technical environments, focusing on clarity and professional communication."
    url="#"
    badge="AEC PROJECT"
  />
</BaseLayout>
